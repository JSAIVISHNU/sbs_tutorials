# Public Supabase credentials (safe to expose to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Enable the AI admission assistant in the frontend. Leave false if not configured.
VITE_AI_ENABLED=false

# Server-side only secrets. Configure these in Supabase Edge Functions or another
# trusted backend environment. Never expose them in frontend code or VITE_ variables.
# GEMINI_API_KEY=
# ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.vercel.app