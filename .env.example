# ─── Supabase (Public – safe for browser) ────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to enable the AI admission assistant chatbot
VITE_AI_ENABLED=false

# ─── WhatsApp Business Cloud API (Server-side only) ──────────────────────────
# These variables are used exclusively by the Vercel serverless function
# api/send-enquiry.js. They are NEVER exposed to the browser.
# Set them in Vercel → Project → Settings → Environment Variables.
#
# Step-by-step setup guide: docs/WHATSAPP_SETUP.md
#
# WHATSAPP_ACCESS_TOKEN          – System User token with whatsapp_business_messaging permission.
#                                  Never use a temporary / personal token in production.
# WHATSAPP_PHONE_NUMBER_ID       – Numeric ID of your WhatsApp Business sender number.
#                                  Found in Meta WhatsApp Manager → Phone Numbers.
# WHATSAPP_RECIPIENT_NUMBER      – Institute owner's WhatsApp number in international format,
#                                  digits only, no '+'. Example: 919180473902
# WHATSAPP_TEMPLATE_NAME         – Exact name of your approved WhatsApp message template.
#                                  Example: sbs_enquiry_notification
# WHATSAPP_TEMPLATE_LANGUAGE     – BCP-47 language code of the approved template.
#                                  Example: en  (or en_US)
# WHATSAPP_API_VERSION           – Meta Graph API version to use. Default: v19.0
#
WHATSAPP_ACCESS_TOKEN=your-system-user-access-token-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here
WHATSAPP_RECIPIENT_NUMBER=919XXXXXXXXX
WHATSAPP_TEMPLATE_NAME=sbs_enquiry_notification
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v19.0

# ─── SECURITY REMINDERS ───────────────────────────────────────────────────────
# • Never commit the real .env file to Git.
# • Never add WHATSAPP_* or SUPABASE service_role to VITE_* variables.
# • Never paste tokens into chat or issues — rotate immediately if exposed.
